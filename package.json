{
  "name": "pi-eval-kernels",
  "version": "0.1.0",
  "description": "Pi extension: persistent Python and Bun/JavaScript cells that call back into the agent's tools over a loopback bridge.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=120000 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "complexity": "uvx lizard -C 3 src python test",
    "check": "bun run typecheck && bun run complexity && bun run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-agent-core": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "typebox": "1.3.27",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "acorn": "^8.18.0"
  },
  "files": [
    "src",
    "python",
    "README.md",
    "NOTICE"
  ]
}
